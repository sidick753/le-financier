generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



enum UserRole {
  SUPER_ADMIN
  ADMIN
  PME_OWNER
  PME_MEMBER
  INVESTOR
  INSTITUTION
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  cniNumber    String?   // Numéro de carte nationale d'identité (rôle INVESTOR)
  role         UserRole
  kycStatus    KycStatus @default(PENDING)
  isActive     Boolean   @default(true)
  twoFaEnabled Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organizationMemberships    OrganizationMember[]
  institutionMembership      InstitutionMember?
  investments                Investment[]
  documentsUploaded          Document[]
  disputesOpened             Dispute[]             @relation("DisputeOpenedBy")
  auditLogs                  AuditLog[]
  notifications              Notification[]
  refreshTokens              RefreshToken[]
  validatedScoringReports    ScoringReport[]
  watchlist                  Watchlist[]
  repaymentPaymentsConfirmed RepaymentPayment[]
  settlementValidations      Investment[]          @relation("InvestmentSettlementValidator")
  fundingRequestsDisbursed   FundingRequest[]       @relation("FundingRequestDisburser")
  repaymentPaymentsValidated RepaymentPayment[]     @relation("RepaymentPaymentValidator")

  @@index([role])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}






enum OrganizationVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum OrganizationMemberRole {
  OWNER
  MEMBER
}

model Organization {
  id                   String                          @id @default(uuid())
  legalName            String
  registrationNumber   String                          @unique // numéro RCCM ou équivalent
  sector               String
  foundedYear          Int?
  legalForm            String?
  address              String?
  city                 String?
  country              String                          @default("CI")
  verificationStatus   OrganizationVerificationStatus  @default(PENDING)
  rejectionReason      String?

  // ── Profil de crédit — attributs de l'entité (pas de la demande), utilisés
  // par le moteur de scoring pour toutes les demandes de financement de cette PME.

  // Secteur & structure (PRET)
  secteurCode          String?
  secteurSaisonnalite  Boolean?  @default(false)
  secteurImportDevises Boolean?  @default(false)
  secteurSoutienPublic Boolean?  @default(false)

  // Santé financière (PRET + EQUITY)
  cashFlowAnnuel         Decimal? @db.Decimal(14, 2)
  fluxMobileMoneyMensuel Decimal? @db.Decimal(14, 2)
  autonomieFinanciere    Decimal? @db.Decimal(5, 4)
  tauxEndettement        Decimal? @db.Decimal(5, 4)
  ratioLiquidite         Decimal? @db.Decimal(5, 4)
  tcamCa3ans             Decimal? @db.Decimal(5, 4)
  margeBrute             Decimal? @db.Decimal(5, 4)
  runwayMois             Int?
  nbClientsActifs        Int?

  // Profil du dirigeant (PRET + EQUITY)
  dirigeantExperienceAns   Int?
  dirigeantAntecedents     String?
  dirigeantIncidentsLegaux String?
  experienceSecteurAns     Int?
  trackRecord              String?

  // Équipe, gouvernance & marché (EQUITY)
  completudeEquipe   String?
  droitsInvestisseur String?
  transparence       String?
  tailleMarche       String?
  scalabilite        String?
  moat               String?
  partMarcheRelative String?

  // Informations bancaires (versement des fonds vers la PME)
  bankName          String?
  bankAccountHolder String?
  bankAccountNumber String?
  bankSwiftCode     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  members         OrganizationMember[]
  fundingRequests FundingRequest[]
  documents       Document[]
  scoringReports  ScoringReport[]
  disputes        Dispute[]
  amlAlerts       AmlAlert[]

  @@index([verificationStatus])
  @@map("organizations")
}

model OrganizationMember {
  id             String                  @id @default(uuid())
  userId         String
  organizationId String
  role           OrganizationMemberRole  @default(MEMBER)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("organization_members")
}

enum InstitutionMemberRole {
  OWNER
  ANALYST
  COMPLIANCE
}

enum InstitutionMemberStatus {
  ACTIVE
  TRAINING
}

model Institution {
  id                  String    @id @default(uuid())
  name                String
  type                String?
  bceaoApprovalNumber String?
  country             String    @default("CI")
  address             String?
  contactEmail        String?
  contactPhone        String?

  envelopeMax     Decimal? @db.Decimal(16, 2)
  ticketMin       Decimal? @db.Decimal(16, 2)
  ticketMax       Decimal? @db.Decimal(16, 2)
  excludedSectors String[] @default([])

  apiKeyHash        String?
  apiKeyLastFour    String?
  apiKeyGeneratedAt DateTime?

  members   InstitutionMember[]
  amlAlerts AmlAlert[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("institutions")
}

model InstitutionMember {
  id            String                  @id @default(uuid())
  userId        String                  @unique
  institutionId String
  role          InstitutionMemberRole   @default(ANALYST)
  status        InstitutionMemberStatus @default(ACTIVE)
  specialty     String?

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([institutionId])
  @@map("institution_members")
}

enum AmlAlertType {
  TRANSACTION_INHABITUELLE
  PEP_DETECTE
  BENEFICIAIRE_NON_IDENTIFIE
}

enum AmlAlertStatus {
  EN_ANALYSE
  BLOQUE
  RESOLU
}

model AmlAlert {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  clientLabel String
  alertType   AmlAlertType
  amount      Decimal?       @db.Decimal(14, 2)
  status      AmlAlertStatus @default(EN_ANALYSE)

  detectedAt DateTime  @default(now())
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([institutionId])
  @@index([status])
  @@map("aml_alerts")
}




enum FundingCategory {
  FACTURE
  PRET
  EQUITY
}

enum FundingRequestStatus {
  DRAFT
  UNDER_REVIEW
  PUBLISHED
  FUNDED
  CLOSED // 100% financé ET décaissé vers la PME (fonds versés, commission prélevée)
  REJECTED
  CANCELLED
}

enum FundingInvestorMode {
  SINGLE_INVESTOR    // la PME veut un seul investisseur qui finance 100% du montant
  MULTIPLE_INVESTORS // la PME accepte que plusieurs investisseurs se partagent le montant
}

model FundingRequest {
  id             String                 @id @default(uuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title          String
  description    String
  category        FundingCategory       @default(PRET)
  amountRequested Decimal               @db.Decimal(14, 2)
  amountRaised    Decimal               @default(0) @db.Decimal(14, 2)
  currency        String                @default("XOF")
  expectedReturn  Decimal?              @db.Decimal(5, 2) // taux/rendement attendu en %
  durationMonths  Int?
  investorMode    FundingInvestorMode   @default(MULTIPLE_INVESTORS)
  status          FundingRequestStatus  @default(DRAFT)
  rejectionReason String?

  publishedAt DateTime?
  closesAt    DateTime?

  // Rempli si le dernier calcul de scoring automatique a échoué (visible admin) ;
  // remis à null dès qu'un calcul aboutit.
  scoringError String?

  // Décaissement — versement des fonds accumulés (validés admin) vers la PME,
  // déclenché manuellement par un admin une fois le statut FUNDED atteint.
  disbursedAt     DateTime?
  disbursedAmount Decimal?  @db.Decimal(14, 2) // = amountRaised - commissions FUNDING_FEE
  disbursedById   String?
  disbursedBy     User?     @relation("FundingRequestDisburser", fields: [disbursedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  investments        Investment[]
  documents          Document[]
  scoringReports     ScoringReport[]
  scoringInput       ScoringInput?
  disputes           Dispute[]
  watchlist          Watchlist[]
  repaymentSchedules RepaymentSchedule[]
  commissions        Commission[]

  @@index([organizationId])
  @@index([status])
  @@map("funding_requests")
}







enum InvestmentStatus {
  INTERESTED
  NEGOTIATING
  COMMITTED
  SETTLEMENT_SUBMITTED // preuve de virement uploadée, en attente de validation admin
  SETTLED_OFF_PLATFORM // virement validé par un admin
  CANCELLED
  REJECTED
}

enum NegotiationOfferAuthor {
  INVESTOR
  PME
}

enum NegotiationOfferStatus {
  PENDING
  ACCEPTED
  COUNTERED
  REJECTED
}

model Investment {
  id               String           @id @default(uuid())
  fundingRequestId String
  fundingRequest   FundingRequest   @relation(fields: [fundingRequestId], references: [id], onDelete: Cascade)
  investorId       String
  investor         User             @relation(fields: [investorId], references: [id])

  amountCommitted Decimal           @db.Decimal(14, 2)
  lockedReturn    Decimal?          @db.Decimal(5, 2)
  status          InvestmentStatus  @default(INTERESTED)

  settlementProofId String?   @unique
  settledAt         DateTime?

  // Validation admin de la preuve de virement (settlementProofId)
  settlementValidatedById   String?
  settlementValidatedBy     User?     @relation("InvestmentSettlementValidator", fields: [settlementValidatedById], references: [id])
  settlementValidatedAt     DateTime?
  settlementRejectionReason String?

  negotiationOffers  NegotiationOffer[]
  repaymentSchedules RepaymentSchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fundingRequestId])
  @@index([investorId])
  @@index([status])
  @@map("investments")
}

model NegotiationOffer {
  id           String                  @id @default(uuid())
  investmentId String
  investment   Investment              @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  proposedBy     NegotiationOfferAuthor
  proposedReturn Decimal                @db.Decimal(5, 2)
  status         NegotiationOfferStatus @default(PENDING)

  createdAt DateTime @default(now())

  @@index([investmentId])
  @@map("negotiation_offers")
}














enum DocumentType {
  KYC_ID
  KYC_PROOF_OF_ADDRESS
  ORGANIZATION_LEGAL
  FINANCIAL_STATEMENT
  FUNDING_REQUEST_ATTACHMENT
  SETTLEMENT_PROOF
  DISPUTE_EVIDENCE
  OTHER
}

enum DocumentStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model Document {
  id   String       @id @default(uuid())
  type DocumentType

  // Stockage : jamais le fichier en base, juste la référence
  storageKey String  // clé/chemin dans le object storage (S3/MinIO)
  fileName   String
  title      String? // titre donné par l'utilisateur (requis pour les documents de type OTHER)
  mimeType   String
  sizeBytes  Int

  status            DocumentStatus @default(PENDING_REVIEW)
  kycRequirementKey String?

  uploadedById String
  uploadedBy   User    @relation(fields: [uploadedById], references: [id])

  // Liens polymorphiques optionnels — un document appartient à UNE de ces entités
  organizationId   String?
  organization     Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fundingRequestId String?
  fundingRequest   FundingRequest?  @relation(fields: [fundingRequestId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([fundingRequestId])
  @@index([type])
  @@map("documents")
}










enum ScoringStatus {
  RECU
  EXTRACTION
  A_COMPLETER
  CALCULATED
  PENDING_VALIDATION
  COMPLEMENTS_DEMANDES
  VALIDATED
  REFUSED
}

model ScoringInput {
  id               String         @id @default(uuid())
  fundingRequestId String         @unique
  fundingRequest   FundingRequest @relation(fields: [fundingRequestId], references: [id], onDelete: Cascade)

  product          String         // FACTURE | PRET | EQUITY

  // Données propres à CETTE demande (le reste — profil PME/dirigeant — vit sur Organization).

  // FACTURE : ce débiteur, cette facture
  debiteurNom             String?
  debiteurType            String?   // grande_entreprise | multinationale | public_solvable | pme_etablie | petite_structure | particulier
  debiteurSolvabilite     String?   // solide | neutre | tension | incident
  echeanceFactureDate     DateTime?
  ancienneteRelation      String?   // plus_2ans | 6mois_2ans | premiere_transaction
  partPlusGrosClient      Decimal?  @db.Decimal(5, 4)
  delaiPaiementMenu       String?   // a_echeance | leger_retard | souvent_retard
  tauxImpaye12m           Decimal?  @db.Decimal(5, 4)

  // PRET : la garantie offerte pour ce prêt précis
  garantieType            String?
  garantieCouverture      Decimal?  @db.Decimal(5, 4)
  runwayMois              Int?
  margeBrute              Decimal?  @db.Decimal(5, 4)
  droitsInvestisseur      String?
  transparence            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("scoring_inputs")
}

model ScoringReport {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  fundingRequestId String?
  fundingRequest   FundingRequest? @relation(fields: [fundingRequestId], references: [id])

  product        String       // FACTURE | PRET | EQUITY
  bareme_version String       @default("2026.1")
  autoScore      Decimal      @db.Decimal(5, 1)
  grade          String?      // A+ | A | BBB | BB | B
  gradeCapped    Boolean      @default(false)
  coverage       Decimal      @db.Decimal(4, 3)
  confidence     Decimal      @db.Decimal(4, 3)
  advanceRate    Decimal?     @db.Decimal(4, 3)
  kpiSnapshot    Json

  status ScoringStatus @default(CALCULATED)

  validatedById   String?
  validatedBy     User?     @relation(fields: [validatedById], references: [id])
  validatedScore  Decimal?  @db.Decimal(5, 1)
  validationNotes String?
  validatedAt     DateTime?

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([status])
  @@index([fundingRequestId])
  @@map("scoring_reports")
}

model ScoringWeight {
  id           String   @id @default(uuid())
  product      String   // FACTURE | PRET | EQUITY
  criterionKey String
  label        String
  weight       Int
  updatedAt    DateTime @updatedAt

  @@unique([product, criterionKey])
  @@map("scoring_weights")
}








model Watchlist {
  id               String         @id @default(uuid())
  investorId       String
  investor         User           @relation(fields: [investorId], references: [id], onDelete: Cascade)
  fundingRequestId String
  fundingRequest   FundingRequest @relation(fields: [fundingRequestId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([investorId, fundingRequestId])
  @@index([investorId])
  @@map("watchlist")
}

enum DisputeStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

enum DisputeCategory {
  PAYMENT_ISSUE
  DOCUMENT_DISPUTE
  FRAUD_SUSPICION
  COMMUNICATION_ISSUE
  OTHER
}

model Dispute {
  id               String          @id @default(uuid())
  organizationId   String?
  organization     Organization?   @relation(fields: [organizationId], references: [id])
  fundingRequestId String?
  fundingRequest   FundingRequest? @relation(fields: [fundingRequestId], references: [id])

  openedById String
  openedBy   User   @relation("DisputeOpenedBy", fields: [openedById], references: [id])

  category    DisputeCategory
  status      DisputeStatus    @default(OPEN)
  title       String
  description String

  resolvedAt    DateTime?
  resolutionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages DisputeMessage[]

  @@index([status])
  @@index([organizationId])
  @@map("disputes")
}

model DisputeMessage {
  id        String  @id @default(uuid())
  disputeId String
  dispute   Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  authorId  String

  content   String
  createdAt DateTime @default(now())

  @@index([disputeId])
  @@map("dispute_messages")
}














enum RepaymentNature {
  INTEREST
  INSTALLMENT
  FINAL_PAYMENT
}

enum RepaymentScheduleStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum RepaymentPaymentStatus {
  PENDING_VALIDATION // soumis par la PME, en attente de validation admin
  CONFIRMED          // validé par un admin (et reversé à l'investisseur, moins commission)
  REJECTED           // preuve rejetée par un admin
  DISPUTED
}

enum CommissionType {
  FUNDING_FEE
  INTEREST_FEE
}

enum CommissionStatus {
  PENDING
  COLLECTED
}

model RepaymentSchedule {
  id               String                  @id @default(uuid())
  fundingRequestId String
  fundingRequest   FundingRequest          @relation(fields: [fundingRequestId], references: [id], onDelete: Cascade)
  investmentId     String
  investment       Investment              @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  dueDate          DateTime
  amountDue        Decimal                 @db.Decimal(14, 2)
  interestAmount   Decimal                 @default(0) @db.Decimal(14, 2)
  principalAmount  Decimal                 @default(0) @db.Decimal(14, 2)
  nature           RepaymentNature
  status           RepaymentScheduleStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments RepaymentPayment[]

  @@index([fundingRequestId])
  @@index([investmentId])
  @@index([dueDate])
  @@index([status])
  @@map("repayment_schedules")
}

model RepaymentPayment {
  id                  String                 @id @default(uuid())
  repaymentScheduleId String
  repaymentSchedule   RepaymentSchedule      @relation(fields: [repaymentScheduleId], references: [id], onDelete: Cascade)

  amountPaid      Decimal                @db.Decimal(14, 2)
  paidAt          DateTime
  status          RepaymentPaymentStatus @default(PENDING_VALIDATION)
  proofDocumentId String?

  // Soumis par (PME)
  confirmedById String
  confirmedBy   User   @relation(fields: [confirmedById], references: [id])

  // Validé par (admin) — la validation vaut aussi décaissement net vers l'investisseur
  // (pas de bundle multi-investisseurs à ce niveau, contrairement au financement)
  validatedById   String?
  validatedBy     User?     @relation("RepaymentPaymentValidator", fields: [validatedById], references: [id])
  validatedAt     DateTime?
  rejectionReason String?
  disbursedAt     DateTime?

  createdAt DateTime @default(now())

  commissions Commission[]

  @@index([repaymentScheduleId])
  @@map("repayment_payments")
}

model Commission {
  id     String           @id @default(uuid())
  type   CommissionType
  status CommissionStatus @default(PENDING)

  fundingRequestId String
  fundingRequest   FundingRequest @relation(fields: [fundingRequestId], references: [id])

  repaymentPaymentId String?
  repaymentPayment   RepaymentPayment? @relation(fields: [repaymentPaymentId], references: [id])

  baseAmount       Decimal @db.Decimal(14, 2)
  rate             Decimal @db.Decimal(5, 4)
  commissionAmount Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  @@index([fundingRequestId])
  @@index([status])
  @@map("commissions")
}

enum NotificationChannel {
  EMAIL
  IN_APP
}

model Notification {
  id      String              @id @default(uuid())
  userId  String
  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel NotificationChannel
  title   String
  body    String
  readAt  DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("notifications")
}

model AuditLog {
  id     String  @id @default(uuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  action     String  // ex: "FUNDING_REQUEST_PUBLISHED"
  entityType String  // ex: "FundingRequest"
  entityId   String
  metadata   Json?
  ipAddress  String?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@map("audit_logs")
}