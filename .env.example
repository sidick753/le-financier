POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_DB=financement
POSTGRES_PORT=4432

REDIS_PORT=4379

# Conteneur MinIO local (docker-compose), utilisé uniquement en dev
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_PORT=4300
MINIO_CONSOLE_PORT=4301

# Client S3 du backend (documents KYC, juridiques, financiers...)
# En local : pointe vers le MinIO ci-dessus (mêmes valeurs que MINIO_ROOT_USER/PASSWORD).
# En prod : pointe vers Backblaze B2 (ou tout autre fournisseur compatible S3), ex.
#   STORAGE_ENDPOINT=https://s3.us-west-002.backblazeb2.com
#   STORAGE_REGION=us-west-002
#   STORAGE_ACCESS_KEY_ID=<keyID B2>
#   STORAGE_SECRET_ACCESS_KEY=<applicationKey B2>
STORAGE_ENDPOINT=http://localhost:4300
STORAGE_REGION=us-east-1
STORAGE_BUCKET=le-financier-documents
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# false uniquement si le fournisseur exige le style virtual-hosted (bucket dans le nom d'hôte)
STORAGE_FORCE_PATH_STYLE=true

DATABASE_URL=postgresql://app:password@localhost:4432/financement?schema=public
REDIS_URL=redis://localhost:4379

PORT=4201
FRONTEND_URL=http://localhost:4200

# Email transactionnel (Resend — https://resend.com/api-keys)
# Sans clé, les emails sont simplement journalisés (aucun envoi, utile en dev).
RESEND_API_KEY=
MAIL_FROM=LeFinancier <notifications@le-financier.com>

NEXT_PUBLIC_API_URL=http://localhost:4201
JWT_SECRET=
